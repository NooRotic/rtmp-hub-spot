# Server Configuration

# The port used by the HTTPS WebRTC Signaling Server
PORT=4001

# The port used by the Node Media Server for RTMP INGESTION
RTMP_PORT=1935

# The port used by Node Media Server for HTTP (e.g., stats)
NMS_HTTP_PORT=8000

# The local bind IP address (0.0.0.0 binds to all available interfaces)
BIND_IP=0.0.0.0
