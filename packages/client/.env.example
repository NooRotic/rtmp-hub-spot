# Client Configuration
# Variables MUST start with VITE_ to be exposed to the client app

# The URL for the WebRTC Signaling Server 
# (In electron, this is accessed directly, in browser it may be proxied)
VITE_SIGNALING_SERVER_URL=https://localhost:4001

# The fallback port for the Vite Dev Server
VITE_DEV_PORT=4443
